{
  "schema_version": 1,
  "quilt_loader": {
    "group": "pe.jas",
    "id": "tailcarft",
    "version": "${version}",
    "metadata": {
      "name": "Tailcarft",
      "description": "Share Minecraft worlds through Tailcarft's userspace WireGuard transport.",
      "license": "BSD-3-Clause",
      "contributors": [
        { "name": "Tailscale" },
        { "name": "Jasper \"Axodouble\" V." }
      ]
    },
    "entrypoints": {
      "client": ["com.tailscale.mclink.QuiltClient"],
      "server": ["com.tailscale.mclink.QuiltServer"]
    },
    "mixin": [
      "mclink.mixins.json",
      { "config": "mclink.quilt.mixins.json", "environment": "client" },
      { "config": "mclink.quilt.server.mixins.json", "environment": "dedicated_server" }
    ],
    "depends": [
      { "id": "quilt_loader", "versions": ">=0.16.4" },
      { "id": "minecraft", "versions": "~${minecraft_version}" },
      { "id": "java", "versions": ">=${java_version}" }
    ]
  }
}
