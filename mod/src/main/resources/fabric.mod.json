{
  "schemaVersion": 1,
  "id": "tailcarft",
  "version": "${version}",
  "name": "Tailcarft",
  "description": "Share Minecraft worlds through Tailcarft's userspace WireGuard transport.",
  "authors": ["Tailscale", "Jasper \"Axodouble\" V."],
  "license": "BSD-3-Clause",
  "environment": "*",
  "entrypoints": {
    "client": ["com.tailscale.mclink.McLinkClient"],
    "server": ["com.tailscale.mclink.McLinkServer"]
  },
  "mixins": ["mclink.mixins.json"],
  "depends": {
    "fabricloader": ">=0.16.10",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*"
  }
